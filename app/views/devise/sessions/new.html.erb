<% content_for :title, "Log in" %>

<div class="w-full max-w-md">
  <% if resource.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
      <ul class="list-disc pl-5 space-y-1">
        <% resource.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white p-8 shadow-sm ring-1 ring-gray-200">
    <h1 class="text-2xl font-bold tracking-tight text-center text-gray-900">Welcome back</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
                          class: "mt-1 block w-full rounded-lg border-0 bg-indigo-50/50 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password, autocomplete: "current-password",
                             class: "mt-1 block w-full rounded-lg border-0 bg-indigo-50/50 px-3 py-2.5 text-gray-900 ring-1 ring-inset ring-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700">
          <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
          Remember me
        </label>
      <% end %>

      <%= f.submit "Log in",
                   class: "w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 cursor-pointer" %>
    <% end %>

    <hr class="mt-6 border-gray-200">
    <div class="mt-4 flex items-center justify-center gap-4 text-sm">
      <% if devise_mapping.registerable? %>
        <%= link_to "Sign up", new_registration_path(resource_name),
                    class: "font-medium text-gray-500 hover:text-indigo-600" %>
      <% end %>
      <% if devise_mapping.recoverable? %>
        <%= link_to "Forgot your password?", new_password_path(resource_name),
                    class: "font-medium text-gray-500 hover:text-indigo-600" %>
      <% end %>
    </div>
  </div>
</div>
