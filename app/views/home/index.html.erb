<% content_for :title, "Home" %>

<div class="w-full max-w-7xl text-center">
  <header class="py-10">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Everything included</h1>
    <p class="mt-3 text-base text-gray-600">
      All the infrastructure decisions have been made. Just start building features.
    </p>
  </header>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% features = [
      {
        title: "Authentication",
        description: "Devise with email confirmation, password reset, and full account management.",
        icon: :shield
      },
      {
        title: "Admin Panel",
        description: "ActiveAdmin gives you a powerful admin interface with minimal configuration.",
        icon: :users
      },
      {
        title: "Background Jobs",
        description: "Sidekiq + Redis for reliable async processing and scheduled recurring tasks.",
        icon: :cog
      },
      {
        title: "Hotwire",
        description: "Turbo + Stimulus for a fast, SPA-like experience without frontend complexity.",
        icon: :bolt
      },
      {
        title: "PostgreSQL",
        description: "Battle-tested relational database fully configured for all environments.",
        icon: :database
      },
      {
        title: "Docker Ready",
        description: "docker-compose.yml ships with the template — full stack up in one command.",
        icon: :cube
      }
    ] %>

    <% features.each do |feature| %>
      <article class="flex flex-col items-center rounded-xl bg-white p-6 text-center ring-1 ring-gray-200 shadow-sm">
        <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
          <%= render "home/feature_icon", icon: feature[:icon] %>
        </div>
        <h2 class="mt-4 text-base font-semibold text-gray-900"><%= feature[:title] %></h2>
        <p class="mt-1 text-sm text-gray-600"><%= feature[:description] %></p>
      </article>
    <% end %>
  </div>
</div>
